[
  "/workspace/fastchess/fastchess",
  "-engine",
  "cmd=/workspace/fuzzy-results/C-release",
  "name=C",
  "-engine",
  "cmd=/workspace/fuzzy-results/A-release",
  "name=A",
  "-each",
  "tc=10+0.1",
  "option.Threads=1",
  "option.Hash=32",
  "option.MultiPV=1",
  "-openings",
  "file=/workspace/fuzzy-results/openings.epd",
  "format=epd",
  "order=sequential",
  "-rounds",
  "6",
  "-repeat",
  "-concurrency",
  "2",
  "-maxmoves",
  "200",
  "-pgnout",
  "file=/workspace/fuzzy-results/STC-C-A.pgn",
  "nodes=true",
  "seldepth=true",
  "timeleft=true",
  "append=false",
  "-autosaveinterval",
  "0",
  "-ratinginterval",
  "2",
  "-scoreinterval",
  "2"
]